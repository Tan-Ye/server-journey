# trade-core 环境变量样例
#
# 用法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不会入库。
#   Copy-Item .env.example .env        （PowerShell）

# ---------------------------------------------------------------- 数据库
# SQLx 读取这个变量跑迁移与编译期校验（sqlx::query! 宏）。
#
# ⚠️ 宿主端口是 5433，不是 5432 —— 本机装了原生 PostgreSQL 18 占用 5432，
#    容器改用 5433 发布以避免端口冲突（详见 docker-compose.yml 里的注释）。
#    容器内部与容器间互连仍然是标准 5432。
#
# 注意：本机跑应用时用 localhost:5433；若应用也跑在 compose 网络里，
#      主机名改成 pg、端口改回 5432（例如 postgres://trade:...@pg:5432/trade_core）
DATABASE_URL=postgres://trade:trade_dev_pw@localhost:5433/trade_core

# Redis 连接串（延迟队列、缓存）。宿主端口 6380，容器内是 6379
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------- 运行环境
# local / staging / production
# 非 production 时才会注册 POST /payments/mock-success 路由
APP_ENV=local

# 日志级别：trace / debug / info / warn / error
RUST_LOG=trade_core=debug,tower_http=debug,sqlx=warn

# HTTP 监听地址
BIND_ADDR=0.0.0.0:3000

# ---------------------------------------------------------------- 业务常量
# 与 docs/03-api-contract.md §7 的常量一一对应。
# 单位见注释；改小改大的影响写在契约文档里，这里只列变量名与默认值。

# 订单支付超时（分钟）。默认 30
ORDER_TIMEOUT=30

# 支付成功后自动发货的延迟（秒）。默认 300（演示用 5 分钟）；0 表示立即发货
AUTO_SHIP_DELAY=300

# 发货后自动签收的时长（天）。默认 3
AUTO_SIGN_DAYS=3

# 签收后自动确认收货的时长（天）。默认 7
COMPLETED_AFTER_DAYS=7

# 退货包裹超期天数（天）。默认 15，超期告警（需人工介入 #5）
AUTO_RETURN_DAYS=15

# 调度器扫描周期（秒）。默认 300。注意超时取消的主通道是延迟队列，本项只是兜底
SCAN_INTERVAL=300

# 退款失败自动重试上限（次）。默认 5，超限告警（需人工介入 #2）
MAX_REFUND_RETRY=5

# Idempotency-Key 保留时长（小时）。默认 24
IDEMPOTENCY_TTL_HOURS=24

# 单次下单单个商品项数量上限（件）。默认 10
MAX_ITEM_QUANTITY=10

# 单笔订单商品项数量上限（项）。默认 20
MAX_ORDER_ITEMS=20

# 列表接口默认/最大每页条数（条）。默认 20 / 50
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50

# 限流（次/分钟）。默认 60 / 600
RATE_LIMIT_ORDER_PER_MINUTE=60
RATE_LIMIT_CALLBACK_PER_MINUTE=600
